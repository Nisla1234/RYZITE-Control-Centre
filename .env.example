# ============================================================
# RYZITE CONTROL CENTRE — ENVIRONMENT VARIABLES
# Copy this file to .env for local development, or configure
# these variables in Vercel Project Settings -> Environment Variables.
# NEVER commit .env or private tokens to GitHub.
# ============================================================

# Production Database (Neon PostgreSQL — REQUIRED on Vercel)
# Example: postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Application URL & Public Site URL
APP_URL="https://ryzite-control-centre.vercel.app"
SITE_URL="https://ryzite.com"
NODE_ENV="production"

# Initial Admin Account Provisioning (Server-Side Only — used on first boot when admin_users is empty)
ADMIN_USERNAME="nisla_admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_NAME="RYZITE Administrator"
ADMIN_EMAIL="info@ryzite.lk"

# Session Security (generate with: openssl rand -hex 32)
SESSION_SECRET="CHANGE_ME_64_CHAR_HEX_SECRET"
SESSION_TTL_HOURS="24"

# Sanity CMS Configuration (Server-Side Only — NEVER prefix with VITE_)
SANITY_PROJECT_ID="hnm8jy5w"
SANITY_DATASET="production"
SANITY_API_VERSION="2024-01-01"
SANITY_API_TOKEN=""

# Google Analytics 4 Data API (Server-Side Only — optional)
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
