# ============================================================
# RYZITE CONTROL CENTRE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env or private tokens to version control.
# ============================================================

# Application URL & Public Site URL
APP_URL="http://localhost:3000"
SITE_URL="https://ryzite.com"
NODE_ENV="development"

# Admin Account Provisioning (Server-Side Only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_NAME="RYZITE Administrator"
ADMIN_EMAIL="admin@ryzite.com"

# Session Security (generate with: openssl rand -hex 32)
SESSION_SECRET="CHANGE_ME_64_CHAR_HEX_SECRET"
SESSION_TTL_HOURS="24"

# Sanity CMS Configuration (Server-Side Only — NEVER prefix with VITE_)
# Existing RYZITE project ID is hnm8jy5w
SANITY_PROJECT_ID="hnm8jy5w"
# Use "staging" for development/testing; switch to "production" only when approved
SANITY_DATASET="staging"
SANITY_API_VERSION="2024-01-01"
# Required for write/publish/upload operations in Sanity
SANITY_API_TOKEN=""

# Google Analytics 4 Data API (Server-Side Only)
# Numeric GA4 Property ID (e.g. 123456789)
GA4_PROPERTY_ID=""
# Google Cloud Service Account email with Viewer access to GA4 property
GA4_CLIENT_EMAIL=""
# Service Account PEM private key (escape newlines as \n)
GA4_PRIVATE_KEY=""

# Live Website Revalidation / Deployment Webhook (Server-Side Only)
# e.g. Vercel Deploy Hook, Cloudflare Pages Deploy Hook, or Astro/Next on-demand revalidation endpoint
DEPLOY_WEBHOOK_URL=""
REVALIDATE_SECRET=""

